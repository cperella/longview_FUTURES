### INITIAL STEPS AND DATA PREPARATION

# input data
  # digital elevation model from the National Map: https://www.usgs.gov/programs/national-geospatial-program/national-map
    # name = elevation_30m
  # NLCD for relevant years: https://www.mrlc.gov/ (already downloaded for SBRE shapefile for years 2001, 2006, 2011, 2016, 2019, 2021)
    # name = landuse_[year]
  # transportation network (roads) from TIGER: https://www.census.gov/geographies/mapping-files/time-series/geo/tiger-line-file.html
    # name = roads
  # county boundaries (already downloaded for NC, SC, TN, GA, VA)
    # name = counties
  # protected areas (from Secured Lands: https://www.conservationgateway.org/ConservationByGeography/NorthAmerica/UnitedStates/edc/reportsdata/terrestrial/secured/Pages/default.aspx or PAD-US: https://www.usgs.gov/programs/gap-analysis-project/science/pad-us-data-download; 
                    PAD-US data already downloaded for states overlapping with SBRE)
    # name = protected_areas
  # cities (tutorial uses cities above 20000; given mostly rural study area, we may want to use a lower population threshold to capture smaller towns like Boone and Hendersonville (>10,000) or even smaller towns like Brevard or Waynesville (>5,000))
    # name = cities_[pop_threshold]
    # note: our cities were derived using the centroids of urban areas polygons as defined by the US Census Bureau (downloaded from Tiger/Line shapefiles database for year 2024); urban areas are defined as having a population of more than 5000 people or at least 2000 households/housing units
  # county population past estimates and future projections (from NCOSBM: https://www.osbm.nc.gov/facts-figures/population-demographics/state-demographer/countystate-population-projections)
    # names = population_trend.csv and population_projection.csv

  


# set working directory

# set computational region to extent covering study area
g.region raster=##RASTER TO SET EXTENT (e.g. NLCD tile)## -p


# convert protected areas from vector to raster
# tutorial uses Secured Lands data for secured lands in eastern US, other option is PAD-US data (and for different conservation scenarios can also use SECAS blueprint)
# set NULLs to zeros for simple raster algebra in next step
v.to.rast input=protected_areas output=protected_areas use=val
r.null map=protected_areas null=0


# create binary rasters of developed/undeveloped areas
# developed or urbanized areas derived from NLCD categories 21-24
# developed = 1, undeveloped = 0, null = unsuitable for development (water, wetlands and protected areas)
# used NLCD legacy years: 2001, 2006, 2011, 2016, 2019
r.mapcalc "urban_2001 = if(landuse_2001 >= 21 && landuse_2001 <= 24, 1, if(landuse_2001 == 11 || landuse_2001 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2006 = if(landuse_2006 >= 21 && landuse_2006 <= 24, 1, if(landuse_2006 == 11 || landuse_2006 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2011 = if(landuse_2011 >= 21 && landuse_2011 <= 24, 1, if(landuse_2011 == 11 || landuse_2011 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2016 = if(landuse_2016 >= 21 && landuse_2016 <= 24, 1, if(landuse_2016 == 11 || landuse_2016 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2019 = if(landuse_2019 >= 21 && landuse_2019 <= 24, 1, if(landuse_2019 == 11 || landuse_2019 >= 90 || protected_areas, null(), 0))"

# convert vector counties to raster with the values of the FIPS code attribute which links to population file
v.to.rast input=counties type=area use=attr attribute_column=FIPS output=counties # note that FIPS have to be numeric, not string
# to subset counties, use the following:
# v.to.rast input=counties type=area where="FIPS in (37021, 37039, 37043, 37075, 37087, 37089, 37099, 37113, 37173, 37175)" use=attr attribute_column=FIPS output=counties_subset
### our study area counties were subset ahead of time

### POTENTIAL SUBMODEL (DERIVE PREDICTORS)

## derive slope in degrees from DEM
r.slope.aspect elevation="elevation_30m" slope=slope

## derive distance from lakes/rivers
# first extract "open water" category from NLCD
r.mapcalc "water = if(landuse_2019 == 11, 1, null())"
# then compute distance and set color table
r.grow.distance input=water distance=dist_to_water
r.colors -n map=dist_to_water color=blues

## derive distnace from protected areas
# use raster of protected areas from above but set NULLs to zero
r.null map=protected_areas setnull=0
r.grow.distance input=protected_areas distance=dist_to_protected
r.colors map=dist_to_protected color=gyr

## smooth transition between forests and other land uses
r.mapcalc "forest = if(landuse_[year] >= 41 && landuse_[year] <= 43, 1, 0)"
r.neighbors -c input=forest output=forest_smooth size=15 method=average
r.colors map=forest_smooth color=ndvi

## smooth transition between agriculture and other land uses
r.mapcalc "agriculture = if(landuse_[year] >= 81 && landuse_[year] <= 82, 1, 0)"
r.neighbors -c input=agriculture output=ag_smooth size=15 method=average

## compute travel time to cities/towns defined as cumulative cost using estimated speed
# first specify speed for different types of roads 
# create a new attribute field (speed) in the roads layer and then assign speed in km/h based on type of road
g.copy vector=roads,myroads
v.db.addcolumn map=myroads columns="speed double precision"
v.db.update map=myroads column=speed value=50 where="MTFCC = 'S1400'" # S1400 = local neighborhood road, rural road, city street 
v.db.update map=myroads column=speed value=100 where="MTFCC IN ('S1100', 'S1200')" # S1100 = primary road, S1200 = secondary road
# rasterize the selected road types using the speed values as raster values
v.to.rast input=myroads type=line where="MTFCC IN ('S1100', 'S1200', 'S1400')" output=roads_speed use=attr attribute_column=speed
# set the rest of the area to low speed and recompute the speed as time to travel through a 30 m cell in minutes
r.null map=roads_speed null=5
r.mapcalc "roads_travel_time = 1.8 / roads_speed"
# compute cost raster
r.cost input=roads_travel_time output=travel_time_cities start_points=cities_[pop_threshold]
r.colors map=travel_time_cities color=byr

## compute road density
v.to.rast input=roads output=roads use=val
r.null map=roads null=0
r.neighbors -c input=roads output=road_dens size=25 method=average

## compute distance to interchanges
v.to.rast input=roads type=line where="MTFCC = 'S1630'" output=interchanges use=val # S1630 = highway ramp
r.grow.distance -m input=interchanges distance=dist_interchanges

### DEVELOPMENT PRESSURE

# compute development pressure with r.futures.devpressure module
# development pressure is a predictor based on number of neighboring cells within set search distance, weighted by distance; allows feedback for future time steps
r.futures.devpressure -n input=urban_2019 output=devpressure_1 method=gravity size=10 gamma=1 scaling_factor=1
r.futures.devpressure -n input=urban_2019 output=devpressure_0_5 method=gravity size=30 gamma=0.5 scaling_factor=0.1
# higher gamma means more rapid decrease of development influence with distance; size is hald the size of the moving window
# lower gamma means that local development influences more distant places
# two layers with different gamma and size parameters are derived for the potential statistical model

### RESCALING VARIABLES

# display ranges of predictor variables using Python tab in GUI
for name in ['slope', 'dist_to_water', 'dist_to_protected', 'forest_smooth', 'travel_time_cities', 'road_dens', 'dist_interchanges', 'devpressure_0_5', 'devpressure_1']:
    minmax = grass.raster_info(name)
    print name, minmax['min'], minmax['max']

# rescale some of the input variables to percentage or km
r.mapcalc "dist_to_water_km = dist_to_water / 1000"
r.mapcalc "dist_to_protected_km = dist_to_protected / 1000"
r.mapcalc "dist_interchanges_km = dist_interchanges / 1000"
r.mapcalc "road_dens_perc = road_dens * 100"
r.mapcalc "forest_smooth_perc = forest_smooth * 100"
r.mapcalc "ag_smooth_perc = ag_smooth * 100"

### SAMPLING

# To build multilevel statistical model describing the relation between predictors and observed change, we randomly sample predictors and response variable. Our response variable is new development between 2001 and 2019.
r.mapcalc "urban_change_01_19 = if(urban_2019 == 1, if(urban_2001 == 0, 1, null()), 0)"

# to sample only in the counties of the study area, clip the development layer
r.mapcalc "urban_change_clip = if(counties, urban_change_01_19)"

# to estimate number of sampling points, use r.report to report number of developed/undeveloped cells and their ratio
r.report map=urban_change_01_19 units=h,c,p

# sample the predictors and the response variable with 10,000 random points in undeveloped areas and 2,000 points in developed area ####### RATIO WILL CHANGE IN OUR STUDY AREA ------> Note, npoints kept the same for initial test
r.sample.category input=urban_change_clip output=sampling sampled=counties,devpressure_0_5,devpressure_1,slope,road_dens_perc,forest_smooth_perc,dist_to_water_km,dist_to_protected_km,dist_interchanges_km,travel_time_cities npoints=10000,2000

# attribute table can be exported as CSV (optional)
v.db.select map=sampling columns=urban_change_clip,counties,devpressure_0_5,devpressure_1,slope,road_dens_perc,forest_smooth_perc,dist_to_water_km,dist_to_protected_km,dist_interchanges_km,travel_time_cities separator=comma file=samples.csv

### DEVELOPMENT POTENTIAL

# find the best model for predicting urbanization with r.futures.potential by trying different combinations of predictions, e.g:
r.futures.potential input=sampling output=potential.csv columns=devpressure_0_5,slope,road_dens_perc,forest_smooth_perc,dist_to_water_km,travel_time_cities developed_column=urban_change_clip subregions_column=counties
# or
r.futures.potential input=sampling output=potential.csv columns=devpressure_1,road_dens_perc,dist_to_water_km,dist_to_protected_km,travel_time_cities developed_column=urban_change_clip subregions_column=counties

# can also run R dredge function to find best model; can specify minimum and maximum number of predictors that should be used in the final model
r.futures.potential -d input=sampling output=potential.csv columns=devpressure_1,slope,road_dens_perc,forest_smooth_perc,dist_to_water_km,dist_to_protected_km,dist_interchanges_km,travel_time_cities developed_column=urban_change_clip subregions_column=counties min_variables=4 max_variables=7

# potential for tutorial created using:
r.futures.potential  input=sampling output=potential.csv columns=devpressure_1,slope,forest_smooth_perc,ag_smooth_perc,dist_interchanges_km,travel_time_cities developed_column=urban_change_clip subregions_column=counties --o

#################### TEST RUN ##########################
r.futures.potential input=sampling output=potential.csv columns=devpressure_0_5,slope,road_dens_perc,forest_smooth_perc,dist_to_water_km,dist_to_protected_km,dist_interchanges_km,travel_time_cities developed_column=urban_change_clip subregions_column=counties

# visualize the initial development potential (suitability) raster from predictors and model coefficients; serves to evaluate development potential model
r.futures.potsurface input=potential.csv subregions=counties output=suitability
r.colors map=suitability color=byr

### DEMAND SUBMODEL

# mask roads so they don't influence per capita land demand
v.to.rast input=roads type=line output=roads_mask use=val
r.mask roads_mask -i

# r.futures.demand derives the population vs. development relation. The relation can be linear/logarithmic/logarithmic2/exponential/exponential approach

  # linear: y = A + Bx
  # logarithmic: y = A + Bln(x)
  # logarithmic2: y = A + B * ln(x - C)          (requires SciPy)
  # exponential: y = Ae^(BX)
  # exp_approach: y = (1 - e^(-A(x - B))) + C    (requires SciPy)

# the format of the input population CSV files is described in the manual
# it is important to have synchronized categories of subregions and the column headers of the CSV files (in our case FIPS number)
# how to simply generate the list of years (for which demand is computed) is described in r.futures.demand manual, for example run this in Python console:
','.join([str(i) for i in range(2019, 2100)])

# finally, create the demand file:
r.futures.demand development=urban_2001,urban_2006,urban_2011,urban_2016,urban_2019 subregions=counties observed_population=population_trend_sbre.csv projected_population=population_projection_ssp1.csv simulation_times=2019,2020,2021,2022,2023,2024,2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045,2046,2047,2048,2049,2050,2051,2052,2053,2054,2055,2056,2057,2058,2059,2060,2061,2062,2063,2064,2065,2066,2067,2068,2069,2070,2071,2072,2073,2074,2075,2076,2077,2078,2079,2080,2081,2082,2083,2084,2085,2086,2087,2088,2089,2090,2091,2092,2093,2094,2095,2096,2097,2098,2099,2100 plot=plot_demand.pdf demand=demand.csv separator=comma

# working directory should now contain files plot_demand.png and demand.csv

# if you have SciPy installed, you can experiment with other methods for fitting the functions:
  # r.futures.demand ... method=logarithmic2
  # r.futures.demand ... method=exp_approach

# when finished, remove the mask
r.mask -r

### PATCH CALIBRATION

# patch calibration is done to derive patches of new development by comparing historical and recent development
# we can run this on the entire area and keep only patches with a minimum size of 2 cells (2 x 30 x 30 m = 1800)
r.futures.calib development_start=urban_2001 development_end=urban_2019 subregions=counties patch_sizes=patches.txt patch_threshold=1800  -l

# resulting patches.txt file contains the distribution of sizes of all found patches of development

# can look at distribution of patch sizes using:
from matplotlib import pyplot as plt
with open('patches.txt') as f:
    patches = [int(patch) for patch in f.readlines()]
plt.hist(patches, 2000)
plt.xlim(0,50)
plt.show()

