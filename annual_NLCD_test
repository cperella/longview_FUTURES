### POTENTIAL SUBMODEL (DERIVE PREDICTORS)

## derive slope in degrees from DEM
#r.slope.aspect elevation="elevation_30m" slope=slope ### used elevation and slope from test runs

## derive distance from lakes/rivers
# first extract "open water" category from NLCD
r.mapcalc "water_2005 = if(landuse_2005 == 11, 1, null())"
# then compute distance and set color table
r.grow.distance input=water_2005 distance=dist_to_water_2005
r.colors -n map=dist_to_water_2005 color=blues

## derive distnace from protected areas ### NOTE: using pad_new file, which is from v4.1 and merged all states that overlap with comp region, but did NOT use to create binary urban rasters, only dist_to_protected
# use raster of protected areas from above but set NULLs to zero
r.null map=pad_new setnull=0
r.grow.distance input=pad_new distance=dist_to_protected_2005
r.colors map=dist_to_protected_2005 color=gyr

## smooth transition between forests and other land uses
r.mapcalc "forest_2005 = if(landuse_2005 >= 41 && landuse_2005 <= 43, 1, 0)"
r.neighbors -c input=forest_2005 output=forest_smooth_2005 size=15 method=average
r.colors map=forest_smooth color=ndvi

## smooth transition between agriculture and other land uses
r.mapcalc "agriculture_2005 = if(landuse_2005 >= 81 && landuse_2005 <= 82, 1, 0)"
r.neighbors -c input=agriculture_2005 output=ag_smooth_2005 size=15 method=average

## compute travel time to cities/towns defined as cumulative cost using estimated speed
# first specify speed for different types of roads 
# create a new attribute field (speed) in the roads layer and then assign speed in km/h based on type of road
g.copy vector=roads,myroads
v.db.addcolumn map=myroads columns="speed double precision"
v.db.update map=myroads column=speed value=50 where="MTFCC = 'S1400'" # S1400 = local neighborhood road, rural road, city street 
v.db.update map=myroads column=speed value=100 where="MTFCC IN ('S1100', 'S1200')" # S1100 = primary road, S1200 = secondary road
# rasterize the selected road types using the speed values as raster values
v.to.rast input=myroads type=line where="MTFCC IN ('S1100', 'S1200', 'S1400')" output=roads_speed use=attr attribute_column=speed
# set the rest of the area to low speed and recompute the speed as time to travel through a 30 m cell in minutes
r.null map=roads_speed null=5
r.mapcalc "roads_travel_time = 1.8 / roads_speed"
# compute cost raster
r.cost input=roads_travel_time output=travel_time_cities start_points=cities_[pop_threshold]
r.colors map=travel_time_cities color=byr

## compute road density
v.to.rast input=roads output=roads use=val
r.null map=roads null=0
r.neighbors -c input=roads output=road_dens size=25 method=average

## compute distance to interchanges
v.to.rast input=roads type=line where="MTFCC = 'S1630'" output=interchanges use=val # S1630 = highway ramp
r.grow.distance -m input=interchanges distance=dist_interchanges

### DEVELOPMENT PRESSURE

# compute development pressure with r.futures.devpressure module
# development pressure is a predictor based on number of neighboring cells within set search distance, weighted by distance; allows feedback for future time steps
# test different gamma and neighborhood sizes
# test 1 - gamma 0.5 size 10
r.futures.devpressure -n input=urban_2005 output=devpressure_g05_s10 method=gravity size=10 gamma=0.5 scaling_factor=1
