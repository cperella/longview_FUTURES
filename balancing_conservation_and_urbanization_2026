######################################################## POTENTIAL SUBMODEL (DERIVE PREDICTORS) #############################################################

### DERIVE PREDICTORS FROM LANDUSE, PROTECTED AREAS, AND ROADS RASTERS
# predictors were extensively tested in previous model runs
# other predictors tested include: forest cover, ag cover, distance to protected areas, log-transformed slope, non-log transformed distances of included distance variables, travel time to cities, distance to interchanges, SVI (census tract level), alternative development pressure parameters

# derive distance from lakes/rivers
# first extract "open water" category from NLCD
r.mapcalc "water_2014 = if(landuse_2014 == 11, 1, null())"
# then compute distance and set color table
r.grow.distance input=water_2014 distance=dist_water_2014

# derive distance to forest land
# extract forest categories from NLCD
r.mapcalc "forest_2014 = if(landuse_2014 >= 41 && landuse_2014 <= 43, 1, null())"
r.grow.distance input=forest_2014 distance=dist_forest_2014

# derive distance to ag land
# extract agriculture categories from NLCD
r.mapcalc "agriculture_2014 = if(landuse_2014 >= 81 && landuse_2014 <= 82, 1, null())"
r.grow.distance input=agriculture_2014 distance=dist_agriculture_2014

# compute distance to roads
r.grow.distance -m input=roads_2014 distance=dist_roads_2014

# compute road density
r.null map=roads_2014 null=0
r.neighbors -c input=roads_2014 output=road_dens_2014 size=25 method=average

# compute DEVELOPMENT PRESSURE with r.futures.devpressure module
# development pressure is a predictor based on number of neighboring cells within set search distance, weighted by distance; allows feedback for future time steps
# tested previously and found that size=8, gamma=2 was the most parsimonious for this model, but other parameters for neighborhood size and gamma should be tested if using different data/study area
r.futures.devpressure -n input=urban_2014 output=devpressure_2014_g2_s8 method=gravity size=8 gamma=2 scaling_factor=1


### RESCALING VARIABLES

# rescale some of the input variables to percentage or km - for distances, convert to km, then log-transform
r.mapcalc "dist_water_2014_km = dist_water_2014 / 1000"
r.mapcalc "dist_water_2014_km_log = log(dist_water_2014_km + 1)"

r.mapcalc "dist_forest_2014_km = dist_forest_2014 / 1000"
r.mapcalc "dist_forest_2014_km_log = log(dist_forest_2014_km + 1)"

r.mapcalc "dist_agriculture_2014_km = dist_agriculture_2014 / 1000"
r.mapcalc "dist_agriculture_2014_km_log = log(dist_agriculture_2014_km + 1)"

r.mapcalc "dist_roads_2014_km = dist_roads_2014 / 1000"
r.mapcalc "dist_roads_2014_km_log = log(dist_roads_2014_km + 1)"

r.mapcalc "road_dens_2014_perc = road_dens_2014 * 100"

### retest other variables to make sure this is the best model

## smooth transition between forests and other land uses
r.neighbors -c input=forest_2014 output=forest_smooth_2014 size=15 method=average

## smooth transition between agriculture and other land uses
r.neighbors -c input=agriculture_2014 output=agriculture_smooth_2014 size=15 method=average

## compute travel time to cities/towns defined as cumulative cost using estimated speed
v.import extent=region input=D:\FUTURES\Data\roads\roads_all\roads_all.shp output=roads_all_2024
v.import extent=region input=D:\FUTURES\Data\places\cities.shp output=cities_5000


# first specify speed for different types of roads 
# create a new attribute field (speed) in the roads layer and then assign speed in km/h based on type of road
v.db.addcolumn map=roads_all_2024 columns="speed double precision"
v.db.update map=roads_all_2024 column=speed value=50 where="MTFCC = 'S1400'" # S1400 = local neighborhood road, rural road, city street 
v.db.update map=roads_all_2024 column=speed value=100 where="MTFCC IN ('S1100', 'S1200')" # S1100 = primary road, S1200 = secondary road
# rasterize the selected road types using the speed values as raster values
v.to.rast input=roads_all_2024 type=line where="MTFCC IN ('S1100', 'S1200', 'S1400')" output=roads_all_2024_speed use=attr attribute_column=speed
# set the rest of the area to low speed and recompute the speed as time to travel through a 30 m cell in minutes
r.null map=roads_all_2024_speed null=5
r.mapcalc "roads_travel_time = 1.8 / roads_all_2024_speed"
# compute cost raster
r.cost input=roads_travel_time output=travel_time_cities start_points=cities_5000

## compute distance to interchanges
v.to.rast input=roads_all_2024 type=line where="MTFCC = 'S1630'" output=interchanges use=val # S1630 = highway ramp
r.grow.distance -m input=interchanges distance=dist_interchanges

## include SVI data using SVI score at the county level; downloaded CSV, joined with counties in ArcGIS pro, then imported into GRASS (used 2014 and 2022 data)
v.import extent=region input=D:\FUTURES\Data\SVI shapefiles\svi_2014_censustr.shp output=svi_censustr_2014
v.to.rast input=svi_censustr_2014 type=area output=svi_censustr_2014 use=attr attribute_column=RPL_THEMES

r.mapcalc "dist_interchanges_km = dist_interchanges / 1000"
r.mapcalc "dist_interchanges_km_log = log(dist_interchanges_km + 1)"


### SAMPLING

# To build a multilevel statistical model describing the relation between predictors and observed change, we randomly sample predictors and response variable. Our response variable is new development between 2000 and 2014.
r.mapcalc "urban_change_00_14 = if(urban_2014 == 1, if(urban_2000 == 0, 1, null()), 0)"

# to sample only in the counties of the study area, clip the development layer
r.mapcalc "urban_change_00_14_clip = if(counties, urban_change_00_14)"

# to estimate number of sampling points, use r.report to report number of developed/undeveloped cells and their ratio ###### LOOK INTO THE SAMPLING POINTS SITUATION
r.report map=urban_change_00_14_clip units=h,c,p

# sample the predictors and the response variable with n random points in undeveloped areas and n points in developed area
# 130,000 in undeveloped areas, 26,000 (original tutorial for 3 counties multiplied by 13 for 39 counties) - total 156k (tested in previous model runs)
r.sample.category input=urban_change_00_14_clip output=sampling_00_14_156k sampled=counties,devpressure_2014_g2_s8,slope,road_dens_2014_perc,dist_forest_2014_km_log,dist_agriculture_2014_km_log,dist_water_2014_km_log,dist_protected_2014_km_log,dist_roads_2014_km_log,svi_censustr_2014 npoints=130000,26000 --overwrite
v.db.select map=sampling_00_14_156k columns=urban_change_00_14_clip,counties,devpressure_2014_g2_s8,slope,road_dens_2014_perc,dist_forest_2014_km_log,dist_agriculture_2014_km_log,dist_water_2014_km_log,dist_roads_2014_km_log,svi_censustr_2014 separator=comma file=D:\FUTURES\secas_sbre_aligned_outputs\sampledpts_00_14_156k.csv --overwrite


