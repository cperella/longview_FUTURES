r.mapcalc "urban_2015 = if(landuse_2015 >= 21 && landuse_2015 <= 24, 1, if(landuse_2015 == 11 || landuse_2015 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2016 = if(landuse_2016 >= 21 && landuse_2016 <= 24, 1, if(landuse_2016 == 11 || landuse_2016 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2017 = if(landuse_2017 >= 21 && landuse_2017 <= 24, 1, if(landuse_2017 == 11 || landuse_2017 >= 90 || protected_areas, null(), 0))"
