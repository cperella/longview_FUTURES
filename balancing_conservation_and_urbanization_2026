# first for 2014
r.import extent=region resolution=region input=D:\nlcd_annual_data\Annual_NLCD_ImpDsc_2014_CU_C1V1\Annual_NLCD_ImpDsc_2014_CU_C1V1.tif output=imperv_2014
# convert to binary roads/non-roads
r.mapcalc "roads_2014 = if(imperv_2014 == 1, 1, null())"

# then for 2024
r.import extent=region resolution=region input=D:\nlcd_annual_data\Annual_NLCD_ImpDsc_2024_CU_C1V1\Annual_NLCD_ImpDsc_2024_CU_C1V1.tif output=imperv_2024
# convert to binary roads/non-roads
r.mapcalc "roads_2024 = if(imperv_2024 == 1, 1, null())"
    
# import protected areas (from  PAD-US: https://www.usgs.gov/programs/gap-analysis-project/science/pad-us-data-download) ### note: new data upload, v4.1
v.import extent=region input=D:\FUTURES\secas_sbre_aligned_inputs\PAD_US_shp\pad_4_1.shp output=protected_areas
# convert protected areas from vector to raster 
v.to.rast input=protected_areas output=protected_areas use=val
# set NULLs to zeros for simple raster algebra in next step
r.null map=protected_areas null=0

# create binary rasters of developed/undeveloped areas for annual NLCD product from 2000-2024
## developed or urbanized areas derived from NLCD categories 21-24
## developed = 1, undeveloped = 0, null = unsuitable for development (water, wetlands and protected areas)
r.mapcalc "urban_2000 = if(landuse_2000 >= 21 && landuse_2000 <= 24, 1, if(landuse_2000 == 11 || landuse_2000 >= 90 || protected_areas, null(), 0))"
