# import roads data
# first for 2014
r.import extent=region input=D:\nlcd_annual_data\Annual_NLCD_ImpDsc_2014_CU_C1V1\Annual_NLCD_ImpDsc_2014_CU_C1V1.tif output=imperv_2014
# convert to binary roads/non-roads
r.mapcalc "roads_2014 = if(imperv_2014 == 1, 1, 0)"
r.null map=roads_2014 setnull=0


# then for 2024
r.import extent=region input=D:\nlcd_annual_data\Annual_NLCD_ImpDsc_2024_CU_C1V1\Annual_NLCD_ImpDsc_2024_CU_C1V1.tif output=imperv_2024
# convert to binary roads/non-roads
r.mapcalc "roads_2024_mask = if(imperv_2024 == 1, 1, 0)"


# import new version protected_areas
v.import extent=region input=C:\Users\cdperell\Documents\The Long View Project files\FUTURES data\PAD_US_shapefiles\pad_new.shp layer=pad_new output=protected_areas
# convert protected areas from vector to raster 
# set NULLs to zeros for simple raster algebra in next step
v.to.rast input=protected_areas output=protected_areas use=val
r.null map=protected_areas null=0

# create binary rasters of developed/undeveloped areas for annual NLCD product from 2006-2023
# developed or urbanized areas derived from NLCD categories 21-24
# developed = 1, undeveloped = 0, null = unsuitable for development (water, wetlands and protected areas)
r.mapcalc "urban_2006 = if(landuse_2006 >= 21 && landuse_2006 <= 24, 1, if(landuse_2006 == 11 || landuse_2006 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2007 = if(landuse_2007 >= 21 && landuse_2007 <= 24, 1, if(landuse_2007 == 11 || landuse_2007 >= 90 || protected_areas, null(), 0))"
