##### FUTURES code for EBCI Long View Project; Using data from 2000-2014 for calibration, 2015-2024 for validation, and 2025-2100 for future projections.
##### Note: this is done in the "EBCI" mapset, with some layers copied from PERMANENT or "annual_NLCD"

### INITIAL STEPS AND DATA PREPARATION

# input data
  # digital elevation model from the National Map: https://www.usgs.gov/programs/national-geospatial-program/national-map
    # name = elevation_30m
    # slope derived previously from elevation_30m; copied from PERMANENT mapset
  # NLCD for 2000-2024: https://www.mrlc.gov/data?f%5B0%5D=project_tax_term_term_parents_tax_term_name%3AAnnual%20NLCD
    # name = landuse_[year]
  # roads from NLCD Impervious Descriptor: https://www.mrlc.gov/data?f%5B0%5D=project_tax_term_term_parents_tax_term_name%3AAnnual%20NLCD
    # name = roads
  # county boundaries from TIGER:
    # name = counties_final
    # copied from annual_NLCD mapset
  # protected areas (from  PAD-US: https://www.usgs.gov/programs/gap-analysis-project/science/pad-us-data-download) ### note: new data upload, v4.1
    # name = protected_areas_4_1
  # cities (cities were derived using the centroids of Urban Areas polygons as defined by the US Census Bureau (downloaded from Tiger/Line shapefiles database for year 2024); urban areas are defined as having a population of more than 5000 people or at least 2000 households/housing units)
    # name = cities_5000
    # copied from PERMANENT mapset
  # county population past estimates and future projections (past estimates from state demography data and NHGIS; future projections from Hauer et al. 2019)
    # names = population_trend.csv and population_projection.csv

# set working directory

# set computational region to extent covering study area
g.region vector=counties_final -p

# import remaining landuse rasters (2000-2005, 2024 copied from annual_NLCD mapset)
r.import extent=region input=D:\nlcd_annual_data\Annual_NLCD_LndCov_2006_CU_C1V1\Annual_NLCD_LndCov_2006_CU_C1V1.tif output=landuse_2006
r.import extent=region input=D:\nlcd_annual_data\Annual_NLCD_LndCov_2007_CU_C1V1\Annual_NLCD_LndCov_2007_CU_C1V1.tif output=landuse_2007
