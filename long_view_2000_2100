r.mapcalc "urban_2020 = if(landuse_2020 >= 21 && landuse_2020 <= 24, 1, if(landuse_2020 == 11 || landuse_2020 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2021 = if(landuse_2021 >= 21 && landuse_2021 <= 24, 1, if(landuse_2021 == 11 || landuse_2021 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2022 = if(landuse_2022 >= 21 && landuse_2022 <= 24, 1, if(landuse_2022 == 11 || landuse_2022 >= 90 || protected_areas, null(), 0))"
r.mapcalc "urban_2023 = if(landuse_2023 >= 21 && landuse_2023 <= 24, 1, if(landuse_2023 == 11 || landuse_2023 >= 90 || protected_areas, null(), 0))"



# mask roads so they don't influence per capita land demand
# set 0s as NULL for mask
r.null map=roads_2024_mask@EBCI setnull=0 
r.mask roads_2024_mask -i
