r.import extent=region input=D:\nlcd_annual_data\Annual_NLCD_LndCov_2009_CU_C1V1\Annual_NLCD_LndCov_2009_CU_C1V1.tif output=landuse_2009
r.import extent=region input=D:\nlcd_annual_data\Annual_NLCD_LndCov_2010_CU_C1V1\Annual_NLCD_LndCov_2010_CU_C1V1.tif output=landuse_2010
