## derive distance from lakes/rivers
# first extract "open water" category from NLCD
r.mapcalc "water_2024 = if(landuse_2024 == 11, 1, null())"
# then compute distance and set color table
r.grow.distance input=water_2024 distance=dist_to_water_2024
r.colors -n map=dist_to_water_2024 color=blues

## derive distnace from protected areas
# use raster of protected areas from above but set NULLs to zero
r.null map=protected_areas setnull=0
r.grow.distance input=protected_areas distance=dist_to_protected_2024
r.colors map=dist_to_protected_2024 color=gyr

## compute road density (using NLCD impervious/roads layer)
r.null map=roads_2024 null=0
r.neighbors -c input=roads_2024 output=road_dens_2024 size=25 method=average

## compute distance to all roads
r.grow.distance -m input=roads_2024 distance=dist_roads_2024

## distance to forest land
# using regular forest 
r.mapcalc "forest_2024_ext = if(landuse_2024 >= 41 && landuse_2024 <= 43, 1, null())"
r.grow.distance input=forest_2024_ext distance=dist_forest_2024

## distance to ag land
# using regular ag
r.mapcalc "agriculture_2024_ext = if(landuse_2024 >= 81 && landuse_2024 <= 82, 1, null())"
r.grow.distance input=agriculture_2024_ext distance=dist_ag_2024

