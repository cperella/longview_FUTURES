### POTENTIAL SUBMODEL (DERIVE PREDICTORS)

## derive distance from lakes/rivers
# first extract "open water" category from NLCD
r.mapcalc "water_2014 = if(landuse_2014 == 11, 1, null())"
# then compute distance and set color table
r.grow.distance input=water_2014 distance=dist_to_water_2014
r.colors -n map=dist_to_water_2014 color=blues

## derive distnace from protected areas
# use raster of protected areas from above but set NULLs to zero
r.null map=protected_areas setnull=0
r.grow.distance input=protected_areas distance=dist_to_protected_2014
r.colors map=dist_to_protected_2014 color=gyr

## smooth transition between forests and other land uses
r.mapcalc "forest_2014 = if(landuse_2014 >= 41 && landuse_2014 <= 43, 1, 0)"
r.neighbors -c input=forest_2014 output=forest_smooth_2014 size=15 method=average
r.colors map=forest_smooth color=ndvi

## smooth transition between agriculture and other land uses
r.mapcalc "agriculture_2014 = if(landuse_2014 >= 81 && landuse_2014 <= 82, 1, 0)"
r.neighbors -c input=agriculture_2014 output=ag_smooth_2014 size=15 method=average

## used previous travel time to cities (using TIGER shapefiles) and distance to interchanges - has differentiation of road types

## compute road density (using NLCD impervious/roads layer)
r.null map=roads_2014 null=0
r.neighbors -c input=roads_2014 output=road_dens_2014 size=25 method=average

## compute distance to all roads
r.grow.distance -m input=roads_2014 distance=dist_roads_2014

## include SVI data using SVI score at the county level; downloaded CSV, joined with counties in ArcGIS pro, then imported into GRASS (used 2014 and 2022 data)
v.to.rast input=svi_counties_2014 type=area output=svi_counties_rast_2014 use=attr attribute_column=F2014_RPL_

### trying some additional predictors based on "Safe Development Paradox" - regular and log-transformed distance to forest, regular and log-transformed distance to agricuture, log-transformed slope

## distance to forest land
# using regular forest 
r.mapcalc "forest_2014_ext = if(landuse_2014 >= 41 && landuse_2014 <= 43, 1, null())"
r.grow.distance input=forest_2014_ext distance=dist_forest_2014

## distance to ag land
# using regular ag
r.mapcalc "agriculture_2014_ext = if(landuse_2014 >= 81 && landuse_2014 <= 82, 1, null())"
r.grow.distance input=agriculture_2014_ext distance=dist_ag_2014

### DEVELOPMENT PRESSURE

# compute development pressure with r.futures.devpressure module
# development pressure is a predictor based on number of neighboring cells within set search distance, weighted by distance; allows feedback for future time steps
# test different gamma and neighborhood sizes (tested fewer than when testing for annual NLCD)
# test 1 - gamma 2 size 8
r.futures.devpressure -n input=urban_2014 output=devpressure_2014_g2_s8 method=gravity size=8 gamma=2 scaling_factor=1
# test 2 - gamma 2 size 10
r.futures.devpressure -n input=urban_2014 output=devpressure_2014_g2_s10 method=gravity size=10 gamma=2 scaling_factor=1
# test 3 - gamma 1.5 size 8
r.futures.devpressure -n input=urban_2014 output=devpressure_2014_g15_s8 method=gravity size=8 gamma=1.5 scaling_factor=1

### RESCALING VARIABLES

# rescale some of the input variables to percentage or km - for distances, convert to km, then log-transform
r.mapcalc expression="slope_log = log(slope)"
r.mapcalc "dist_to_water_km_2014 = dist_to_water_2014 / 1000"
r.mapcalc "dist_to_water_km_2014_log = log(dist_to_water_km_2014)"
r.mapcalc "dist_to_protected_km_2014 = dist_to_protected_2014 / 1000"
r.mapcalc "dist_to_protected_km_2014_log = log(dist_to_protected_km_2014)"
